<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=yes">
    <title>Pastel Pink Portal | Elegant Dashboard</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:opsz,wght@14..32,300;14..32,400;14..32,500;14..32,600;14..32,700;14..32,800&family=Playfair+Display:wght@700;800;900&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        :root {
            --pink-50: #fff5f8;
            --pink-100: #ffe8f0;
            --pink-200: #ffd4e3;
            --pink-300: #fec5d9;
            --pink-400: #f9aec7;
            --pink-500: #e891ae;
            --pink-600: #d47295;
            --pink-700: #b85478;
            --pink-800: #964060;
            --glass-white: rgba(255, 255, 255, 0.85);
            --glass-blur: blur(12px);
            --shadow-sm: 0 8px 20px rgba(0, 0, 0, 0.04);
            --shadow-md: 0 20px 35px -12px rgba(216, 112, 147, 0.25);
            --shadow-lg: 0 25px 45px -12px rgba(0, 0, 0, 0.15);
            --shadow-hover: 0 30px 45px -15px rgba(184, 84, 120, 0.35);
        }

        body {
            font-family: 'Inter', sans-serif;
            background: linear-gradient(135deg, #fff0f5 0%, #ffe4ed 50%, #ffd9e6 100%);
            min-height: 100vh;
            color: #4a2c38;
            overflow-x: hidden;
            position: relative;
        }

        /* Animated Background Orbs */
        .orb {
            position: fixed;
            border-radius: 50%;
            filter: blur(70px);
            z-index: -2;
            pointer-events: none;
            animation: floatOrb 20s ease-in-out infinite;
        }

        @keyframes floatOrb {
            0%, 100% { transform: translate(0, 0) scale(1); }
            33% { transform: translate(30px, -40px) scale(1.1); }
            66% { transform: translate(-20px, 30px) scale(0.95); }
        }

        .orb-1 { width: 400px; height: 400px; background: #fec5d9; top: -100px; right: -50px; animation-duration: 25s; }
        .orb-2 { width: 350px; height: 350px; background: #ffd4e3; bottom: -80px; left: -80px; animation-duration: 30s; animation-delay: -5s; }
        .orb-3 { width: 250px; height: 250px; background: #f9aec7; top: 40%; left: 20%; animation-duration: 22s; animation-delay: -10s; opacity: 0.7; }

        /* Glass Header */
        .header {
            background: rgba(255, 245, 248, 0.75);
            backdrop-filter: var(--glass-blur);
            border-bottom: 1px solid rgba(255, 255, 255, 0.6);
            padding: 30px 40px 50px;
            text-align: center;
            position: relative;
            z-index: 10;
            box-shadow: var(--shadow-sm);
        }

        .header-content {
            max-width: 1200px;
            margin: 0 auto;
            position: relative;
        }

        .portal-title {
            font-family: 'Playfair Display', serif;
            font-size: 62px;
            font-weight: 900;
            background: linear-gradient(125deg, #b85478, #e891ae, #d47295);
            background-clip: text;
            -webkit-background-clip: text;
            color: transparent;
            letter-spacing: -1px;
            text-shadow: 0 2px 10px rgba(184,84,120,0.2);
            margin-bottom: 15px;
        }

        .portal-title i {
            background: none;
            background-clip: unset;
            -webkit-background-clip: unset;
            color: #d47295;
            font-size: 56px;
        }

        .portal-subtitle {
            font-size: 18px;
            font-weight: 500;
            color: #b85478;
            background: rgba(255,255,255,0.6);
            display: inline-block;
            padding: 8px 28px;
            border-radius: 80px;
            backdrop-filter: blur(4px);
            margin-top: 12px;
        }

        .login-btn {
            position: absolute;
            top: 0;
            right: 0;
            background: rgba(255,255,255,0.9);
            border: 1.5px solid #f9aec7;
            color: #b85478;
            padding: 12px 28px;
            border-radius: 50px;
            font-weight: 700;
            font-size: 14px;
            cursor: pointer;
            transition: all 0.3s cubic-bezier(0.2, 0.9, 0.4, 1.1);
            font-family: 'Inter', sans-serif;
            display: flex;
            align-items: center;
            gap: 10px;
            box-shadow: var(--shadow-sm);
        }

        .login-btn i { font-size: 16px; }
        .login-btn:hover {
            background: white;
            border-color: #d47295;
            transform: translateY(-3px);
            box-shadow: var(--shadow-md);
            color: #964060;
        }

        /* Search Section */
        .search-section {
            display: flex;
            justify-content: center;
            padding: 30px 20px 20px;
            position: relative;
            z-index: 10;
        }

        .search-card {
            background: var(--glass-white);
            backdrop-filter: var(--glass-blur);
            border-radius: 80px;
            padding: 6px 6px 6px 28px;
            display: flex;
            align-items: center;
            gap: 12px;
            box-shadow: var(--shadow-md);
            border: 1px solid rgba(255,255,255,0.8);
            width: 500px;
            max-width: 90vw;
            transition: all 0.3s;
        }

        .search-card:focus-within {
            box-shadow: 0 0 0 4px rgba(232,145,174,0.3);
            transform: scale(1.02);
        }

        .search-card i {
            color: #d47295;
            font-size: 20px;
        }

        .search-box {
            flex: 1;
            padding: 16px 0;
            border: none;
            background: transparent;
            font-size: 16px;
            font-family: 'Inter', sans-serif;
            outline: none;
            color: #4a2c38;
            font-weight: 500;
        }

        .search-box::placeholder {
            color: #c99aae;
            font-weight: 400;
        }

        .search-shortcut {
            background: #f9aec7;
            color: white;
            padding: 6px 12px;
            border-radius: 40px;
            font-size: 12px;
            font-weight: 600;
            opacity: 0.7;
        }

        /* Zebra Menu Grid - Premium */
        .menu-container {
            max-width: 1300px;
            margin: 20px auto 60px;
            padding: 0 30px;
        }

        .menu-row {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 28px;
            padding: 28px 24px;
            border-radius: 48px;
            transition: all 0.3s;
        }

        /* ZEBRA PATTERN - elegant striped background */
        .menu-row:nth-child(even) {
            background: linear-gradient(105deg, rgba(254,197,217,0.25) 0%, rgba(255,245,248,0.4) 100%);
            backdrop-filter: blur(4px);
            border: 1px solid rgba(255,255,255,0.5);
            margin: 8px 0;
        }

        .menu-row:nth-child(odd) {
            background: transparent;
        }

        /* Menu Card - premium 3D effect */
        .menu-card {
            background: rgba(255, 255, 255, 0.92);
            backdrop-filter: blur(8px);
            border-radius: 32px;
            padding: 32px 20px;
            text-align: center;
            cursor: pointer;
            transition: all 0.4s cubic-bezier(0.2, 0.9, 0.4, 1.2);
            border: 1px solid rgba(249,174,199,0.3);
            position: relative;
            overflow: hidden;
            box-shadow: var(--shadow-sm);
        }

        .menu-card::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            height: 5px;
            background: linear-gradient(90deg, #f9aec7, #e891ae, #d47295);
            transform: scaleX(0);
            transition: transform 0.4s;
            border-radius: 32px 32px 0 0;
        }

        .menu-card:hover::before {
            transform: scaleX(1);
        }

        .menu-card:hover {
            transform: translateY(-12px);
            box-shadow: var(--shadow-hover);
            background: white;
            border-color: #e891ae;
        }

        .menu-icon {
            font-size: 68px;
            margin-bottom: 20px;
            display: inline-block;
            transition: all 0.3s;
        }

        .menu-card:hover .menu-icon {
            transform: scale(1.1) rotate(3deg);
        }

        .menu-title {
            font-size: 1.2rem;
            font-weight: 800;
            color: #964060;
            letter-spacing: -0.3px;
            margin-bottom: 8px;
        }

        .menu-desc {
            font-size: 0.8rem;
            color: #c28aa0;
            font-weight: 500;
            margin-top: 8px;
        }

        /* Glass badge pada card */
        .menu-badge {
            position: absolute;
            top: 16px;
            right: 16px;
            background: rgba(232,145,174,0.2);
            border-radius: 30px;
            padding: 4px 10px;
            font-size: 10px;
            font-weight: 600;
            color: #d47295;
            backdrop-filter: blur(4px);
        }

        /* No result style */
        .no-result {
            text-align: center;
            padding: 60px 30px;
            background: rgba(255,245,248,0.8);
            backdrop-filter: blur(12px);
            border-radius: 64px;
            margin: 40px auto;
            max-width: 500px;
        }

        .no-result i {
            font-size: 64px;
            color: #f9aec7;
            margin-bottom: 20px;
        }

        .no-result h3 {
            color: #b85478;
            margin-bottom: 10px;
        }

        /* Footer premium */
        .footer {
            text-align: center;
            padding: 35px 25px;
            background: rgba(255, 235, 242, 0.7);
            backdrop-filter: blur(10px);
            border-top: 1px solid rgba(255,255,255,0.7);
            color: #b2738a;
            font-weight: 500;
            margin-top: 20px;
        }

        .footer i {
            margin: 0 6px;
            color: #e891ae;
        }

        /* Modal Notification */
        .modal {
            display: none;
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(0,0,0,0.4);
            backdrop-filter: blur(5px);
            z-index: 1000;
            justify-content: center;
            align-items: center;
        }

        .modal-content {
            background: white;
            border-radius: 48px;
            padding: 40px 50px;
            text-align: center;
            max-width: 400px;
            width: 85%;
            box-shadow: var(--shadow-lg);
            animation: modalPop 0.3s ease;
        }

        @keyframes modalPop {
            from { transform: scale(0.9); opacity: 0; }
            to { transform: scale(1); opacity: 1; }
        }

        .modal-content i {
            font-size: 70px;
            color: #e891ae;
            margin-bottom: 20px;
        }

        .modal-content h3 {
            color: #b85478;
            font-size: 24px;
            margin-bottom: 15px;
        }

        .modal-content p {
            color: #8c6a78;
            margin-bottom: 25px;
        }

        .modal-close {
            background: linear-gradient(135deg, #e891ae, #d47295);
            border: none;
            padding: 12px 32px;
            border-radius: 50px;
            color: white;
            font-weight: 700;
            cursor: pointer;
            transition: 0.2s;
        }

        .modal-close:hover {
            transform: scale(1.03);
            box-shadow: 0 5px 15px rgba(216,112,147,0.4);
        }

        @media (max-width: 900px) {
            .menu-row { grid-template-columns: repeat(2, 1fr); gap: 20px; }
            .portal-title { font-size: 44px; }
            .login-btn { position: static; margin-bottom: 20px; display: inline-flex; justify-content: center; }
            .header-content { display: flex; flex-direction: column; align-items: center; }
            .login-btn { position: relative; top: auto; right: auto; margin-bottom: 20px; width: fit-content; }
        }

        @media (max-width: 600px) {
            .menu-row { grid-template-columns: 1fr; }
            .menu-row:nth-child(even) { padding: 24px 16px; }
            .portal-title { font-size: 36px; }
        }

        /* Floating decorative */
        .float-icon {
            position: fixed;
            bottom: 20px;
            right: 20px;
            font-size: 28px;
            opacity: 0.4;
            pointer-events: none;
            z-index: 5;
            animation: floatHeart 4s infinite alternate;
        }

        @keyframes floatHeart {
            0% { transform: translateY(0); opacity: 0.3; }
            100% { transform: translateY(-15px); opacity: 0.6; }
        }
    </style>
</head>
<body>

<div class="orb orb-1"></div>
<div class="orb orb-2"></div>
<div class="orb orb-3"></div>
<div class="float-icon">
    <i class="fas fa-heart"></i>
</div>

<header class="header">
    <div class="header-content">
        <button class="login-btn" id="loginBtn">
            <i class="fas fa-user-circle"></i> Login
        </button>
        <h1 class="portal-title">
            <i class="fas fa-crown"></i> PORTAL WEBSITE
        </h1>
        <p class="portal-subtitle">
            <i class="fas fa-sparkle"></i> Sistem Informasi Terpadu | Pastel Elegance
        </p>
    </div>
</header>

<div class="search-section">
    <div class="search-card">
        <i class="fas fa-search"></i>
        <input type="text" class="search-box" id="searchInput" placeholder="Cari menu... Kerusakan, Komputer, Service Report, Arsip, Terima, Zebra">
        <div class="search-shortcut">⌘K</div>
    </div>
</div>

<div class="menu-container" id="menuContainer"></div>

<footer class="footer">
    <i class="fas fa-heart"></i> 2025 Pastel Pink Portal — Elegant Dashboard with Zebra Design 
    <i class="fas fa-star"></i>
</footer>

<div class="modal" id="notificationModal">
    <div class="modal-content">
        <i class="fas fa-palette"></i>
        <h3>✨ Fitur Development</h3>
        <p>Modul <span id="modalModuleName" style="font-weight:700; color:#d47295;"></span> sedang dalam tahap pengembangan. Segera hadir dengan fitur lengkap!</p>
        <button class="modal-close" onclick="closeModal()">Tutup</button>
    </div>
</div>

<script>
    // Menu Data sesuai permintaan: DATA KERUSAKAN BARANG, PENCATATAN KOMPUTER, SERVICE REPORT, ARSIP DOKUMEN, TANDA TERIMA BARANG, DESAIN ZEBRA
    const menus = [
        { name: "DATA KERUSAKAN BARANG", icon: "fas fa-tools", desc: "Kelola data kerusakan & perbaikan", color: "#e891ae" },
        { name: "PENCATATAN KOMPUTER", icon: "fas fa-laptop-code", desc: "Inventarisasi & monitoring komputer", color: "#d47295" },
        { name: "SERVICE REPORT", icon: "fas fa-file-alt", desc: "Laporan service & maintenance", color: "#f9aec7" },
        { name: "ARSIP DOKUMEN", icon: "fas fa-archive", desc: "Manajemen dokumen digital", color: "#b85478" },
        { name: "TANDA TERIMA BARANG", icon: "fas fa-receipt", desc: "Tracking penerimaan barang", color: "#e891ae" },
        { name: "DESAIN ZEBRA", icon: "fas fa-grip-lines", desc: "Tampilan zebra stripe eksklusif", color: "#d47295", special: true }
    ];

    let currentFilter = "";

    function renderMenu() {
        const container = document.getElementById('menuContainer');
        container.innerHTML = "";
        
        let filtered = menus.filter(menu => 
            menu.name.toLowerCase().includes(currentFilter.toLowerCase())
        );
        
        if (filtered.length === 0) {
            container.innerHTML = `
                <div class="no-result">
                    <i class="fas fa-search"></i>
                    <h3>Tidak ada menu ditemukan</h3>
                    <p>Coba kata kunci: kerusakan, komputer, service, arsip, terima, zebra</p>
                </div>
            `;
            return;
        }
        
        // Split into rows (3 items per row) untuk zebra pattern
        const rows = [];
        for (let i = 0; i < filtered.length; i += 3) {
            rows.push(filtered.slice(i, i + 3));
        }
        
        rows.forEach(rowItems => {
            const rowDiv = document.createElement('div');
            rowDiv.className = 'menu-row';
            
            rowItems.forEach(menu => {
                const card = document.createElement('div');
                card.className = 'menu-card';
                card.setAttribute('data-menu', menu.name);
                
                // Badge untuk efek glass
                const badge = document.createElement('div');
                badge.className = 'menu-badge';
                badge.innerHTML = '<i class="fas fa-sparkle"></i>';
                
                const iconElem = document.createElement('div');
                iconElem.className = 'menu-icon';
                iconElem.innerHTML = `<i class="${menu.icon}" style="font-size: 68px; color: ${menu.color};"></i>`;
                
                const titleElem = document.createElement('div');
                titleElem.className = 'menu-title';
                titleElem.textContent = menu.name;
                
                const descElem = document.createElement('div');
                descElem.className = 'menu-desc';
                descElem.textContent = menu.desc;
                
                card.appendChild(badge);
                card.appendChild(iconElem);
                card.appendChild(titleElem);
                card.appendChild(descElem);
                
                // Event click
                card.addEventListener('click', () => {
                    if (menu.special || menu.name === "DESAIN ZEBRA") {
                        showModal(menu.name);
                    } else {
                        showModal(menu.name);
                    }
                });
                
                rowDiv.appendChild(card);
            });
            
            container.appendChild(rowDiv);
        });
    }
    
    function showModal(moduleName) {
        const modal = document.getElementById('notificationModal');
        const span = document.getElementById('modalModuleName');
        span.textContent = moduleName;
        modal.style.display = 'flex';
    }
    
    function closeModal() {
        const modal = document.getElementById('notificationModal');
        modal.style.display = 'none';
    }
    
    // Search functionality
    const searchInput = document.getElementById('searchInput');
    searchInput.addEventListener('input', (e) => {
        currentFilter = e.target.value;
        renderMenu();
    });
    
    // Login button click
    const loginBtn = document.getElementById('loginBtn');
    loginBtn.addEventListener('click', () => {
        showModal("Login System");
    });
    
    // Close modal when clicking outside
    window.onclick = function(event) {
        const modal = document.getElementById('notificationModal');
        if (event.target === modal) {
            closeModal();
        }
    };
    
    // Keyboard shortcut: Ctrl+K or Cmd+K to focus search
    document.addEventListener('keydown', (e) => {
        if ((e.ctrlKey || e.metaKey) && e.key === 'k') {
            e.preventDefault();
            searchInput.focus();
        }
    });
    
    // Initial render
    renderMenu();
    
    // Add animation on scroll
    const observerOptions = { threshold: 0.1, rootMargin: "0px 0px -50px 0px" };
    const observer = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
            if (entry.isIntersecting) {
                entry.target.style.opacity = "1";
                entry.target.style.transform = "translateY(0)";
            }
        });
    }, observerOptions);
    
    document.querySelectorAll('.menu-row').forEach(row => {
        row.style.opacity = "0";
        row.style.transform = "translateY(30px);
        row.style.transition = "all 0.5s ease";
        observer.observe(row);
    });
    
    // Re-observe after render
    const originalRender = renderMenu;
    renderMenu = function() {
        originalRender();
        setTimeout(() => {
            document.querySelectorAll('.menu-row').forEach(row => {
                row.style.opacity = "0";
                row.style.transform = "translateY(30px)";
                row.style.transition = "all 0.5s ease";
                observer.observe(row);
            });
        }, 100);
    };
    renderMenu();
</script>
</body>
</html>